{
  "manifest_version": 3,
  "name": "Cinemorph — Netflix look for YouTube",
  "version": "1.2.0",
  "description": "Transforms YouTube into a polished streaming experience with a cinematic home, shelves, search, channels and player.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]

}
